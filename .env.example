# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# In deployed environments these come from Cloud Secret Manager — see apphosting.yaml.

# --- Dodo Payments ---------------------------------------------------------
# Dashboard → Developer → API Keys. Server-side only; never expose to the client.
DODO_PAYMENTS_API_KEY=sk_test_xxxxxxxxxxxxxxxx
# live_mode or test_mode — selects which Dodo environment the SDK talks to.
DODO_ENV=test_mode
# Dashboard → Products. Read at build time (pricing is prerendered) and at
# request time by /api/checkout.
DODO_PRODUCT_ID_PRO_MONTHLY=pdt_xxxxxxxxxxxxxxxx
DODO_PRODUCT_ID_PRO_YEARLY=pdt_xxxxxxxxxxxxxxxx

# --- App -------------------------------------------------------------------
# Base URL used to build the checkout return_url. Defaults to
# http://localhost:3000 when unset.
APP_URL=http://localhost:3000

# --- Public (inlined into the client bundle at build time) -----------------
# live or test — picks the Dodo checkout overlay environment.
NEXT_PUBLIC_DODO_ENV=test
# Google Cloud console → Credentials → OAuth 2.0 Client ID (Web application).
# Used by the /auth iframe for the Drive authorization-code flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
